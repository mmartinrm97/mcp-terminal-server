---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import ProblemSolution from "../components/ProblemSolution.astro";
import HowItWorks from "../components/HowItWorks.astro";
import FeaturesGrid from "../components/FeaturesGrid.astro";
import ToolCatalog from "../components/ToolCatalog.astro";
import StatsSection from "../components/StatsSection.astro";
import FinalCTA from "../components/FinalCTA.astro";
import SiteFooter from "../components/SiteFooter.astro";

const stats = [
  { value: 13, suffix: "", label: "MCP Tools" },
  { value: 7, suffix: "", label: "Tested Clients" },
  { value: 360, suffix: "", label: "Passing Tests" },
  { value: 0, suffix: "", label: "New Sonar Issues" },
];

const features = [
  {
    title: "terminal_read_until",
    desc: "Block until a regex pattern appears in output. Handles interactive prompts with configurable timeouts.",
    code: 'terminal_read_until({ pattern: "package name:" })',
  },
  {
    title: "terminal_screenshot",
    desc: "Render ANSI to clean text. Detect if the agent is inside vim, nano, htop, or any full-screen app.",
    code: 'terminal_screenshot({ id: "sess-1" })',
  },
  {
    title: "terminal_session_diagnostics",
    desc: "Capture timeline, recent events, and a fresh semantic screenshot when an agent gets stuck.",
    code: 'terminal_session_diagnostics({ id: "sess-1" })',
  },
  {
    title: "terminal_send_signal",
    desc: "Send SIGINT, SIGTSTP, or SIGKILL to the foreground process. Press Ctrl+C programmatically.",
    code: 'terminal_send_signal({ id: "sess-1", signal: "SIGINT" })',
  },
  {
    title: "terminal_create_session",
    desc: "Up to 10 simultaneous sessions with per-session shell, cwd, dimensions, and TTL auto-cleanup.",
    code: 'terminal_create_session({ shell: "bash", cwd: "/project" })',
  },
  {
    title: "terminal_session_export",
    desc: "Export replay-friendly transcripts for bug reports, issue filing, and cross-agent debugging.",
    code: 'terminal_session_export({ id: "sess-1", event_limit: 25 })',
  },
];

const agents = [
  {
    name: "Claude Code",
    status: "Verified",
  },
  {
    name: "Codex",
    status: "Verified",
  },
  {
    name: "Cursor",
    status: "Verified",
  },
  {
    name: "OpenCode",
    status: "Verified",
  },
  {
    name: "Copilot",
    status: "Verified",
  },
  {
    name: "Pi",
    status: "Verified",
  },
  {
    name: "Antigravity",
    status: "Verified",
  },
];
---

<Layout
  title="terminalize — Interactive Terminal for AI Agents"
  description="Give your AI agents a persistent PTY terminal. npm init, gh pr create, psql — all interactive, all real."
>
  <Nav />
  <Hero />
  <ProblemSolution />
  <HowItWorks />
  <FeaturesGrid features={features} />
  <ToolCatalog />
  <StatsSection stats={stats} agents={agents} />
  <FinalCTA />
  <SiteFooter />
</Layout>

<style is:global>
  /* ── Scrollbar ── */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #0d1117;
  }
  ::-webkit-scrollbar-thumb {
    background: #30363d;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #6c5ce7;
  }
  * {
    scrollbar-color: #30363d #0d1117;
    scrollbar-width: thin;
  }

  /* ── Reveal on scroll ── */
  html[data-js="enhanced"] [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }
  html[data-js="enhanced"] [data-reveal][data-revealed] {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  document.documentElement.dataset.js = "enhanced";

  async function copyTextToClipboard(text) {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return true;
    }

    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "absolute";
    textarea.style.left = "-9999px";
    document.body.appendChild(textarea);
    textarea.select();
    const success = document.execCommand("copy");
    document.body.removeChild(textarea);

    if (!success) {
      throw new Error("Copy command failed");
    }

    return true;
  }

  const copyButtons = document.querySelectorAll("[data-copy-button]");

  for (const button of copyButtons) {
    button.addEventListener("click", async () => {
      const text = button.dataset.copyValue;
      const label = button.querySelector("[data-copy-label]");
      const defaultLabel = button.dataset.copyDefault ?? "Copy";
      const successLabel = button.dataset.copySuccess ?? "Copied";

      if (!text || !label) return;

      try {
        await copyTextToClipboard(text);
        label.textContent = successLabel;
        button.dataset.state = "success";
      } catch {
        label.textContent = "Select manually";
        button.dataset.state = "error";
      }

      window.setTimeout(() => {
        label.textContent = defaultLabel;
        button.dataset.state = "idle";
      }, 1800);
    });
  }

  // ── Counter animation ──
  const counters = document.querySelectorAll(".counter");
  const counterObs = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target;
        const target = parseInt(el.dataset.target, 10);
        animateCounter(el, target);
        counterObs.unobserve(el);
      }
    },
    { threshold: 0.5 },
  );

  for (const c of counters) counterObs.observe(c);

  function animateCounter(el, target) {
    const duration = 1500;
    const steps = 30;
    const increment = target / steps;
    let current = 0;
    const stepTime = duration / steps;
    const timer = setInterval(() => {
      current += increment;
      if (current >= target) {
        el.textContent = target;
        clearInterval(timer);
      } else {
        el.textContent = Math.floor(current);
      }
    }, stepTime);
  }

  // ── Reveal on scroll ──
  const revealEls = document.querySelectorAll(
    "[data-reveal]:not([data-revealed])",
  );
  if (revealEls.length > 0) {
    const revealObs = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target;
          const delay = parseInt(el.dataset.delay, 10) || 0;
          setTimeout(() => {
            el.dataset.revealed = "true";
          }, delay);
          revealObs.unobserve(el);
        }
      },
      { threshold: 0.1 },
    );

    for (const el of revealEls) revealObs.observe(el);
  }
</script>
