---
const proofItems = [
  "Real PTY sessions, not mocked shell output",
  "Validated across Claude, Codex, Cursor, OpenCode, Copilot, Pi, and AGY",
  "Quality gate passing with cross-platform CI coverage",
];

const miniMetrics = [
  { value: "13", label: "MCP tools" },
  { value: "360", label: "tests passing" },
  { value: "0", label: "new sonar issues" },
];
---

<section class="relative overflow-hidden px-4 pb-20 pt-28 md:pt-32">
  <div aria-hidden="true" class="hero-orb hero-orb-left"></div>
  <div aria-hidden="true" class="hero-orb hero-orb-right"></div>

  <div
    class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(430px,520px)]"
  >
    <div class="relative z-10">
      <p
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-[#30363d] bg-[#161b22]/80 px-4 py-1.5 font-mono text-[11px] uppercase tracking-[0.24em] text-[#a89cf7]"
        data-reveal
      >
        <span class="h-2 w-2 rounded-full bg-[#2ecc71]"></span>
        Interactive terminal MCP for real agents
      </p>

      <h1
        class="max-w-4xl text-5xl font-black tracking-[-0.04em] text-white md:text-7xl md:leading-[0.94]"
        data-reveal
      >
        Stop making agents <span class="text-[#8edcff]">guess</span> at the terminal.
      </h1>

      <p
        class="mt-6 max-w-2xl text-lg leading-8 text-[#98a3b3] md:text-xl"
        data-reveal
        data-delay="80"
      >
        <span class="font-semibold text-[#e6edf3]">terminalize</span> gives AI agents
        a persistent PTY they can actually read, wait on, navigate, and interrupt.
        `npm init`, `gh pr create`, `create-vite`, `psql` — all interactive, all real.
      </p>

      <ul class="mt-8 space-y-3" data-reveal data-delay="140">
        {
          proofItems.map((item) => (
            <li class="flex items-start gap-3 text-sm leading-6 text-[#c3ccd8]">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#00d2ff]" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>

      <div
        class="mt-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center"
        data-reveal
        data-delay="220"
      >
        <button
          type="button"
          data-copy-button
          data-copy-value="npm install -g terminalize"
          data-copy-default="Copy install command"
          data-copy-success="Copied"
          class="copy-command group inline-flex w-full items-center justify-between gap-4 rounded-2xl border border-[#30363d] bg-[#11161f] px-5 py-4 text-left transition-all hover:border-[#6c5ce7]/70 hover:bg-[#141b27] sm:w-auto sm:min-w-[338px]"
        >
          <div>
            <div
              class="mb-1 font-mono text-[11px] uppercase tracking-[0.22em] text-[#8b949e]"
            >
              Install
            </div>
            <code class="font-mono text-sm text-[#f4f7fb]"
              >npm install -g terminalize</code
            >
          </div>

          <span
            class="inline-flex items-center gap-2 rounded-full border border-[#30363d] px-3 py-1 text-xs font-semibold text-[#c9d3df] transition-colors"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
              ></path>
            </svg>
            <span data-copy-label>Copy</span>
          </span>
        </button>

        <a
          href="https://github.com/mmartinrm97/terminalize#readme"
          target="_blank"
          class="inline-flex items-center gap-2 rounded-xl bg-[#6c5ce7] px-6 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-px hover:bg-[#5b4bd5]"
        >
          Read the docs
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7h4m0 0v4m0-4L10 14"></path>
          </svg>
        </a>
      </div>

      <div
        class="mt-10 grid max-w-2xl grid-cols-1 gap-3 sm:grid-cols-3"
        data-reveal
        data-delay="280"
      >
        {
          miniMetrics.map((metric) => (
            <div class="rounded-2xl border border-[#273042] bg-[#101722]/88 px-4 py-4">
              <div class="text-2xl font-bold tracking-tight text-white">
                {metric.value}
              </div>
              <div class="mt-1 text-xs uppercase tracking-[0.18em] text-[#8b949e]">
                {metric.label}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="relative z-10" data-reveal data-delay="120">
      <div class="terminal-shell">
        <div class="terminal-shell__topbar">
          <div class="flex items-center gap-2">
            <span class="terminal-shell__dot bg-[#ff6b6b]"></span>
            <span class="terminal-shell__dot bg-[#ffd93d]"></span>
            <span class="terminal-shell__dot bg-[#2ecc71]"></span>
          </div>
          <span
            class="rounded-full border border-[#30363d] px-2.5 py-1 font-mono text-[11px] text-[#8b949e]"
          >
            sess_backend · bash
          </span>
        </div>

        <div class="grid gap-4 p-4 lg:grid-cols-[1.2fr_0.8fr]">
          <div class="rounded-2xl border border-[#202938] bg-[#0d1117] p-4">
            <div class="mb-3 flex items-center justify-between">
              <span
                class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#8b949e]"
              >
                live session
              </span>
              <span
                class="rounded-full bg-[#2ecc71]/12 px-2 py-1 font-mono text-[11px] text-[#2ecc71]"
              >
                shell ready
              </span>
            </div>

            <div
              class="space-y-2 font-mono text-[13px] leading-6 text-[#c9d3df]"
            >
              <div class="terminal-step" style="--delay: 0.15s">
                <span class="text-[#8b949e]">$</span>
                <span class="text-[#f4f7fb]">npm init</span>
              </div>
              <div class="terminal-step" style="--delay: 0.65s">
                <span class="text-[#8b949e]">package name:</span>
                <span class="text-[#8edcff]">(project)</span>
              </div>
              <div class="terminal-step" style="--delay: 1.15s">
                <span class="text-[#6c5ce7]">terminal_read_until</span>
                <span class="text-[#8b949e]">pattern="package name:"</span>
              </div>
              <div class="terminal-step" style="--delay: 1.75s">
                <span class="text-[#6c5ce7]">terminal_write</span>
                <span class="text-[#8b949e]">"terminalize-demo\n"</span>
              </div>
              <div class="terminal-step" style="--delay: 2.25s">
                <span class="text-[#8b949e]">✓ package.json created</span>
              </div>
              <div class="terminal-step" style="--delay: 2.8s">
                <span class="text-[#8b949e]">$</span>
                <span class="terminal-caret">█</span>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <div class="rounded-2xl border border-[#202938] bg-[#111824] p-4">
              <div
                class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-[#8b949e]"
              >
                semantic screenshot
              </div>
              <pre
                class="overflow-hidden rounded-xl bg-[#0d1117] p-3 font-mono text-[11px] leading-5 text-[#9ec4ff]"><code>{`{
  "terminal_mode": "shell",
  "detectedPrompt": "package name:",
  "isInteractive": true,
  "recommendedNextAction": "respond",
  "idleMs": 214
}`}</code></pre>
            </div>

            <div class="rounded-2xl border border-[#202938] bg-[#111824] p-4">
              <div class="mb-3 flex items-center justify-between">
                <span
                  class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#8b949e]"
                >
                  agent-proofed
                </span>
                <span
                  class="rounded-full bg-[#00d2ff]/10 px-2 py-1 font-mono text-[11px] text-[#8edcff]"
                >
                  prompt-by-prompt
                </span>
              </div>
              <p class="text-sm leading-6 text-[#b8c4d4]">
                Built for agents that need to wait, inspect, and react instead
                of spamming Enter and hoping the TUI behaves.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-orb {
    position: absolute;
    border-radius: 9999px;
    filter: blur(90px);
    opacity: 0.28;
    pointer-events: none;
  }

  .hero-orb-left {
    left: -120px;
    top: 40px;
    width: 280px;
    height: 280px;
    background: #6c5ce7;
  }

  .hero-orb-right {
    right: -80px;
    top: 120px;
    width: 240px;
    height: 240px;
    background: #00d2ff;
  }

  .copy-command[data-state="success"] {
    border-color: rgba(46, 204, 113, 0.7);
    box-shadow: 0 0 0 1px rgba(46, 204, 113, 0.28);
  }

  .copy-command[data-state="success"] [data-copy-label] {
    color: #2ecc71;
  }

  .copy-command[data-state="error"] [data-copy-label] {
    color: #ff6b6b;
  }

  .terminal-shell {
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid rgba(108, 92, 231, 0.22);
    background:
      linear-gradient(180deg, rgba(108, 92, 231, 0.06), rgba(13, 17, 23, 0.98)),
      #111620;
    box-shadow:
      0 22px 60px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .terminal-shell__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    border-bottom: 1px solid #273042;
    background: rgba(255, 255, 255, 0.02);
  }

  .terminal-shell__dot {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    display: inline-block;
  }

  .terminal-step {
    opacity: 0.96;
    transform: translateY(0);
    animation:
      terminal-step-glow 6s ease-in-out infinite,
      terminal-step-fade 0.45s ease-out both;
    animation-delay: var(--delay), var(--delay);
  }

  .terminal-caret {
    color: #8edcff;
    animation: terminal-caret-blink 0.9s step-end infinite;
  }

  @keyframes terminal-step-fade {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 0.96;
      transform: translateY(0);
    }
  }

  @keyframes terminal-step-glow {
    0%,
    100% {
      text-shadow: none;
    }
    15% {
      text-shadow: 0 0 14px rgba(142, 220, 255, 0.08);
    }
  }

  @keyframes terminal-caret-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
