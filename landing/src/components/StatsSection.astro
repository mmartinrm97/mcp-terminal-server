---
import ClaudeIcon from "./icons/ClaudeIcon.astro";
import CodexIcon from "./icons/CodexIcon.astro";
import CopilotIcon from "./icons/CopilotIcon.astro";
import CursorIcon from "./icons/CursorIcon.astro";
import OpencodeIcon from "./icons/OpencodeIcon.astro";
import PiIcon from "./icons/PiIcon.astro";

export interface Agent {
  name: string;
  status: "Verified" | "Partial";
}

export interface Stat {
  value: number;
  suffix: string;
  label: string;
}

export interface Props {
  stats: Stat[];
  agents: Agent[];
}

const { stats, agents } = Astro.props;

const statusTone = {
  Verified: "border-[#2ecc71]/30 bg-[#2ecc71]/8 text-[#9df0ba]",
  Partial: "border-[#f5b942]/30 bg-[#f5b942]/8 text-[#ffd98a]",
} as const;

const iconByName = {
  "Claude Code": ClaudeIcon,
  Codex: CodexIcon,
  Cursor: CursorIcon,
  OpenCode: OpencodeIcon,
  Copilot: CopilotIcon,
  Pi: PiIcon,
} as const;
---

<section id="stats" class="border-t border-[#202938] px-4 py-24">
  <div class="mx-auto max-w-5xl">
    <div class="mx-auto max-w-2xl text-center">
      <p
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-[#30363d] bg-[#11161f] px-4 py-1.5 font-mono text-[11px] uppercase tracking-[0.22em] text-[#8edcff]"
        data-reveal
      >
        Evidence first
      </p>
      <h2 class="text-3xl font-bold tracking-tight md:text-4xl" data-reveal>
        Tested against real clients, not guessed for marketing.
      </h2>
      <p
        class="mx-auto mt-4 max-w-xl text-base leading-7 text-[#98a3b3]"
        data-reveal
      >
        The compatibility story here matches the repo reality: verified where
        real runs completed, partial where setup or deeper interactive flows
        still need tightening.
      </p>
    </div>

    <div
      class="mt-14 grid grid-cols-2 gap-4 md:grid-cols-4"
      data-reveal
      data-delay="80"
    >
      {
        stats.map((s) => (
          <div class="rounded-2xl border border-[#273042] bg-[#101722]/92 px-5 py-5 text-center shadow-[0_10px_30px_rgba(0,0,0,0.18)]">
            <div class="text-3xl font-black tracking-tight text-white md:text-4xl">
              <span class="counter" data-target={s.value}>
                {s.value}
              </span>
              {s.suffix}
            </div>
            <div class="mt-2 text-xs uppercase tracking-[0.18em] text-[#8b949e]">
              {s.label}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-18 rounded-[28px] border border-[#273042] bg-[#11161f]/92 p-6 md:p-8" data-reveal data-delay="140">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <h3 class="text-2xl font-semibold text-white">Compatibility, aligned with reality</h3>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-[#98a3b3]">
            No Windsurf. No Qwen. No imaginary badge wall. Just the clients you
            actually installed, configured, and tested.
          </p>
        </div>
        <a
          href="https://github.com/mmartinrm97/terminalize/blob/main/docs/COMPATIBILITY.md"
          target="_blank"
          class="inline-flex items-center gap-2 text-sm font-semibold text-[#8edcff] hover:text-white transition-colors"
        >
          Read full matrix
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h4m0 0v4m0-4L10 14"></path>
          </svg>
        </a>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        {
          agents.map((agent) => {
            const Icon = iconByName[agent.name as keyof typeof iconByName];

            return (
              <div class="flex items-center gap-3 rounded-full border border-[#30363d] bg-[#0d1117] px-4 py-2.5">
                <span class="flex h-7 w-7 items-center justify-center rounded-full border border-[#273042] bg-[#11161f] text-[#d6deea]">
                  {Icon ? <Icon class="h-4 w-4" aria-hidden="true" /> : <span class="text-[11px] font-bold">A</span>}
                </span>
                <span class="text-sm font-semibold text-[#e6edf3]">{agent.name}</span>
                <span
                  class:list={[
                    "rounded-full border px-2.5 py-1 text-[11px] font-mono uppercase tracking-[0.18em]",
                    statusTone[agent.status],
                  ]}
                >
                  {agent.status}
                </span>
              </div>
            );
          })
        }
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl border border-[#202938] bg-[#0d1117] p-4">
          <div class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#8b949e]">
            quality gate
          </div>
          <p class="mt-3 text-sm leading-6 text-[#c3ccd8]">
            SonarQube passes. CI is green on Windows, Ubuntu, and macOS.
          </p>
        </div>
        <div class="rounded-2xl border border-[#202938] bg-[#0d1117] p-4">
          <div class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#8b949e]">
            WSL / Unix-like
          </div>
          <p class="mt-3 text-sm leading-6 text-[#c3ccd8]">
            Interactive flows like <code>npm init</code> and <code>create-vite</code> were tested in Unix-like shells too.
          </p>
        </div>
        <div class="rounded-2xl border border-[#202938] bg-[#0d1117] p-4">
          <div class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#8b949e]">
            partial means partial
          </div>
          <p class="mt-3 text-sm leading-6 text-[#c3ccd8]">
            Partial is not a fake green badge. It means the MCP path works, but
            deeper client behavior still needs proof.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
