---
---

<section class="relative py-28 px-4 text-center overflow-hidden">
  <!-- Radial glow -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(108,92,231,0.18)_0%,transparent_65%)]"></div>
  </div>

  <div class="relative max-w-2xl mx-auto">
    <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-10 leading-tight" data-reveal>
      Your AI deserves<br />a real terminal.
    </h2>

    <div
      class="inline-block bg-[#1a1b26] border border-[#30363d] rounded-xl px-8 py-5 font-mono text-xl md:text-2xl text-[#00d2ff] mb-10"
      data-reveal
      data-delay="100"
    >
      $ npx terminalize
    </div>

    <div class="flex items-center justify-center gap-4 flex-wrap" data-reveal data-delay="200">
      <a
        href="https://github.com/mmartinrm97/terminalize#readme"
        target="_blank"
        class="px-6 py-3 rounded-lg border border-[#30363d] text-[#e6edf3] text-sm font-semibold hover:border-[#8b949e] hover:bg-[#161b22] transition-all"
      >
        Read the Docs
      </a>
      <a
        href="https://github.com/mmartinrm97/terminalize"
        target="_blank"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-[#6c5ce7] hover:bg-[#5b4bd5] text-white text-sm font-semibold transition-all hover:-translate-y-px"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        Star on GitHub
      </a>
    </div>
  </div>
</section>
