#!/usr/bin/env bash

# Conventional Commits validation
# Pattern: type(scope): description
# Types: feat, fix, chore, docs, style, refactor, perf, test, build, ci, revert
COMMIT_MSG=$(cat "$1")

if ! echo "$COMMIT_MSG" | grep -qE "^(feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert)(\(.+\))?: .{1,}$"; then
  echo "❌ Invalid commit message format."
  echo ""
  echo "Expected: type(scope): description"
  echo "  type: feat | fix | chore | docs | style | refactor | perf | test | build | ci | revert"
  echo "  scope: optional, e.g. (pty-session), (server)"
  echo ""
  echo "  Examples:"
  echo "    feat: add completion markers"
  echo "    fix(pty-session): handle Windows kill signal"
  echo "    chore: bump version to 0.2.0"
  echo ""
  exit 1
fi
